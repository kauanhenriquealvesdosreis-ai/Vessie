#
# ============================================================
#  VESSIE AI - Variáveis de ambiente (cópia: cp .env.example .env)
# ============================================================
#

# --- Identidade / modelo de IA --------------------------------
APP_NAME=Vessie AI
AI_PROVIDER=gguf            # gguf | lmstudio | openai | anthropic | auto
AI_MODEL=LocalModel.gguf
SYSTEM_PROMPT=Você é a Vessie AI, uma assistente inteligente, amigável e humana. Seja clara, concisa e prática.

# --- GGUF (modelo local) --------------------------------------
GGUF_MODEL_PATH=
GGUF_MODEL_DIR=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
GGUF_CONTEXT_SIZE=0

# --- LM Studio (agente loop / multi-modelo) -------------------
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODELS=

# --- OpenAI / Anthropic (opcionais) ---------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=

# --- Segurança DM-only (só por DM / token) --------------------
DM_ONLY=false
DM_TOKEN=SEU_TOKEN_SUPER_SEGURO_AQUI
VESSIE_STORAGE_KEY=minha-chave-secreta-de-armazenamento

# --- Sistemas do VessieCore -----------------------------------
THINK_MODE=auto             # auto | manual | disabled
SPELL_CORRECTION=false
PROMPT_ENHANCEMENT=false
MEMORY_ENABLED=true
MEMORY_FILE=./vessieai-core/memory/Memory.md
EMOTION_SYSTEM=true
SHARE_THINKING_ENABLED=true
SHARE_THINKING_FILE=./vessieai-core/sharing/Share-Thinking.md
ADAPTIVE_SYSTEM_PROMPT=false
WEB_SEARCH_ENABLED=true
AGENT_LOOP_ENABLED=true
AGENT_LOOP_MAX_CYCLES=5
AGENT_LOOP_MAX_RETRIES=3
LIFE_FILE=./vessieai-core/personality/Life.md

# --- Tags System (<Think>, <Code>, <Interpretagem>) -----------
TAGS_ENABLED=true
TAG_MODE=auto               # auto | manual | off

# --- Cache / compressão (economia de tokens) ------------------
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_SIZE=200
CACHE_VARIANTS=10

# --- Multi-Agent ----------------------------------------------
MULTI_AGENTS=false

# --- MCP (Model Context Protocol) -----------------------------
MCP_ENABLED=false
MCP_CONFIG=./vessieai-core/config/mcp-servers.json

# --- Auto-Evolução --------------------------------------------
FORCE_ALL_MODULE=false
AUTO_SUSTAIN=false
AUTO_SUSTAIN_MS=3600000

# --- Web / porta ----------------------------------------------
PORT=3000
