# ============================================================
#  VESSIE AI - Variáveis de ambiente (copie para .env)
# ============================================================

# Provedor ativo: gguf | lmstudio | openai | anthropic
# 'gguf' executa um modelo local (LocalModel.gguf) via node-llama-cpp.
AI_PROVIDER=gguf

# Nome do modelo (exibido na interface / usado por provedores de nuvem)
AI_MODEL=LocalModel.gguf

# --- GGUF (modelo local) -------------------------------------
# Caminho EXATO para o arquivo .gguf (opcional).
# Se deixar vazio, o servidor procura por "LocalModel.gguf"
# (ou qualquer .gguf) nas pastas models/ do repositório.
GGUF_MODEL_PATH=

# Pasta alternativa onde procurar .gguf (opcional)
GGUF_MODEL_DIR=

# Parâmetros de geração do modelo local
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
# Tamanho do contexto (janela de tokens). 0 = usar o padrão da arquitetura.
# Ex.: 2048, 4096, 8192…
GGUF_CONTEXT_SIZE=0

# --- LM Studio (fallback / alternativa) ----------------------
LM_STUDIO_URL=http://localhost:1234

# --- OpenAI (opcional) ---------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (opcional) ------------------------------------
# ANTHROPIC_API_KEY=

# --- Sistemas do VessieCore ----------------------------------
THINK_MODE=auto                 # auto | manual | disabled
SPELL_CORRECTION=false
PROMPT_ENHANCEMENT=false
MEMORY_ENABLED=false
EMOTION_SYSTEM=false
SHARE_THINKING_ENABLED=false
ADAPTIVE_SYSTEM_PROMPT=false
WEB_SEARCH_ENABLED=false
AGENT_LOOP_ENABLED=false

# Porta do servidor
PORT=3000
